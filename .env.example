# Required for the chat assistant to answer. Read server-side only, never sent to the browser.
AI_API_KEY=

# Optional. OpenAI-compatible base URL. Defaults to the NVIDIA integrate endpoint.
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional. Model id served by that endpoint.
AI_MODEL=meta/llama-3.1-8b-instruct

# Optional. Used for metadata canonical/OG URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional. HTTP port. Defaults to 3000.
PORT=3000

# Optional. Directory served as static assets. Defaults to public.
STATIC_DIR=public
